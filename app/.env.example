# PostKing → /admin/blog sync (scripts/sync-postking-blog.ts). Never commit real values.
# POSTKING_API_TOKEN=
# POSTKING_API_URL=https://try.postking.app
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Local development only: point `npm run dev` at a local Supabase stack. A production build
# ignores these and always uses the live project (see src/lib/supabase.ts).
# VITE_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
# VITE_LOCAL_SUPABASE_ANON_KEY=
